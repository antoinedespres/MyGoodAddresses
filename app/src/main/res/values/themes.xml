<resources>
    <!--
      Launch theme. androidx.core.splashscreen swaps to postSplashScreenTheme
      once the first frame is ready, so no manual delay is needed.
    -->
    <style name="Theme.MyGoodAddresses" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/orange</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MyGoodAddresses.Main</item>
    </style>

    <!-- Colours come from the Compose theme; this only styles the window. -->
    <style name="Theme.MyGoodAddresses.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
