<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/restaurant_image"
        android:background="@drawable/baseline_camera_alt_24"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop" />

    <EditText
        android:id="@+id/restaurant_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/restaurant_image"
        android:hint="@string/name"
        android:padding="16dp" />

    <EditText
        android:id="@+id/restaurant_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/restaurant_name"
        android:hint="@string/type"
        android:padding="16dp" />

    <Button
        android:id="@+id/use_location_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/restaurant_type"
        android:drawableLeft="@drawable/baseline_location_on_24"
        android:text="@string/use_my_location"
        app:srcCompat="@drawable/baseline_location_on_24"/>

    <EditText
        android:id="@+id/restaurant_address_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/use_location_button"
        android:hint="@string/street"
        android:padding="16dp" />

    <EditText
        android:id="@+id/restaurant_post_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/restaurant_address_line"
        android:hint="@string/post_code"
        android:padding="16dp" />

    <EditText
        android:id="@+id/restaurant_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/restaurant_post_code"
        android:hint="@string/city"
        android:padding="16dp" />

    <Button
        android:id="@+id/save_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/restaurant_city"
        android:text="@string/save"
        android:textColor="@color/white"
        android:padding="16dp" />
</RelativeLayout>
